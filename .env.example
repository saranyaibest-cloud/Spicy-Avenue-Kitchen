# Copy to .env (never commit .env). All values below are placeholders.
# Leave the GRAPH_* values empty to run on the bundled workbook (data/menu.xlsx) in labelled "fallback" mode.

# Microsoft Entra (Azure AD) app registration
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# Point at the workbook with ONE of these:
GRAPH_SHARE_URL=            # the "Copy link" sharing URL of the workbook in OneDrive/SharePoint
# GRAPH_DRIVE_ID=
# GRAPH_ITEM_ID=

# Optional
MENU_TTL_SECONDS=300        # how long the server reuses one download of the workbook
PORT=8787
